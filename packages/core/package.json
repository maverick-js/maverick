{
  "name": "@maverick-js/core",
  "version": "0.43.2",
  "description": "Build type-safe UI component libraries.",
  "bugs": {
    "url": "https://github.com/maverick-js/maverick/issues"
  },
  "license": "MIT",
  "contributors": [
    "Rahim Alwer <rahim.alwer@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maverick-js/maverick.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/prod/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "node": "./dist/server/index.js",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/dev/jsx-runtime.d.ts",
      "node": "./dist/server/jsx-runtime.js",
      "development": "./dist/dev/jsx-runtime.js",
      "default": "./dist/prod/jsx-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test --run",
    "test:watch": "vp test --watch"
  },
  "dependencies": {
    "@maverick-js/std": "workspace:*"
  },
  "devDependencies": {
    "@maverick-js/signals": "^6.0.0",
    "@types/node": "^22.15.0",
    "@typescript/native-preview": "7.0.0-dev.20260525.1",
    "type-fest": "^4.41.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
